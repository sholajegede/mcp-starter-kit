{
  "name": "mcp-starter-kit",
  "version": "2.0.0-alpha.0",
  "description": "Production foundation for MCP servers: any auth provider, any database, any billing system, any runtime.",
  "type": "module",
  "license": "MIT",
  "author": "Shola Jegede",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sholajegede/mcp-starter-kit.git"
  },
  "homepage": "https://github.com/sholajegede/mcp-starter-kit#readme",
  "bugs": "https://github.com/sholajegede/mcp-starter-kit/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "oauth",
    "authorization",
    "billing",
    "entitlements",
    "rate-limiting",
    "llm-router",
    "cloudflare-workers",
    "vercel",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "import": "./dist/billing/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js"
    },
    "./node": {
      "types": "./dist/runtime/node.d.ts",
      "import": "./dist/runtime/node.js"
    },
    "./stdio": {
      "types": "./dist/runtime/stdio.d.ts",
      "import": "./dist/runtime/stdio.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "jose": "^6.2.18"
  },
  "peerDependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
