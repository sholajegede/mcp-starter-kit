{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "paths": {
      "mcp-starter-kit": [
        "./src/index.ts"
      ],
      "mcp-starter-kit/*": [
        "./src/*/index.ts",
        "./src/runtime/*.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
