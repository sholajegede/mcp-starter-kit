#!/usr/bin/env node

/**
 * MCP Starter Kit CLI
 * Creates new MCP applications with authentication, database, and billing
 */

import { program } from 'commander';
import { createApp } from '../dist/cli/create-app.js';
import { readFileSync } from 'fs';
import { join, dirname } from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

// Read package.json for version
const packageJson = JSON.parse(readFileSync(join(__dirname, '../package.json'), 'utf8'));

program
  .name('mcp-starter')
  .description('Create MCP applications with authentication, database, and billing')
  .version(packageJson.version)
  .action(async () => {
    const { createInterface } = await import('readline');
    const rl = createInterface({
      input: process.stdin,
      output: process.stdout
    });

    const question = (prompt) => {
      return new Promise((resolve) => {
        rl.question(prompt, resolve);
      });
    };

    try {
      console.log('🚀 MCP Starter Kit');
      console.log('Create MCP applications with authentication, database, and billing');
      console.log('');
      
      // Get app name
      const appName = await question('📝 What would you like to name your application? ');
      if (!appName.trim()) {
        console.log('❌ Application name is required');
        process.exit(1);
      }

      // Get template selection
      console.log('');
      console.log('📋 Choose your template:');
      console.log('  1. blog      - Blog management system (posts, comments)');
      console.log('  2. ecommerce - E-commerce system (products, orders)');
      console.log('  3. crm       - Customer relationship management (contacts, deals, tasks)');
      console.log('  4. todo      - Simple todo management system');
      console.log('');
      
      const templateChoice = await question('🎯 Enter your choice (1-4): ');
      const templateMap = {
        '1': 'blog',
        '2': 'ecommerce', 
        '3': 'crm',
        '4': 'todo'
      };
      
      const template = templateMap[templateChoice.trim()];
      if (!template) {
        console.log('❌ Invalid choice. Please select 1, 2, 3, or 4');
        process.exit(1);
      }

      rl.close();

      console.log('');
      console.log(`🚀 Creating ${appName} with ${template} template...`);
      await createApp(appName, template, './');
      console.log('✅ Application created successfully!');
      console.log('');
      console.log('📋 Next steps:');
      console.log(`1. cd ${appName}`);
      console.log('2. Copy .env.example to .env and configure your credentials:');
      console.log('   - Get DATABASE_URL from Neon (https://neon.tech)');
      console.log('   - Get Kinde credentials from Kinde (https://kinde.com)');
      console.log('   - Set KINDE_ISSUER_URL, KINDE_CLIENT_ID, KINDE_CLIENT_SECRET');
      console.log('3. npm run setup-db');
      console.log('4. npm run auth-server (in a separate terminal)');
      console.log('5. npm run dev');
      console.log('');
      console.log('🔐 Authentication Setup:');
      console.log('   - Visit http://localhost:3000 to login');
      console.log('   - Copy your ID token from the auth page');
      console.log('   - Use the save_token tool in Cursor to authenticate');
      console.log('');
      console.log('🔗 Configure Cursor MCP:');
      console.log('   - Add to ~/.cursor/mcp.json:');
      console.log(`   {`);
      console.log(`     "mcpServers": {`);
      console.log(`       "${appName}": {`);
      console.log(`         "command": "node",`);
      console.log(`         "args": ["dist/universal-server.js"],`);
      console.log(`         "cwd": "${process.cwd()}/${appName}",`);
      console.log(`         "env": {`);
      console.log(`           "DATABASE_URL": "your_database_url",`);
      console.log(`           "KINDE_ISSUER_URL": "your_kinde_issuer_url",`);
      console.log(`           "KINDE_CLIENT_ID": "your_kinde_client_id",`);
      console.log(`           "KINDE_CLIENT_SECRET": "your_kinde_client_secret",`);
      console.log(`           "JWT_SECRET": "your_jwt_secret"`);
      console.log(`         }`);
      console.log(`       }`);
      console.log(`     }`);
      console.log(`   }`);
      console.log('   - Restart Cursor to load MCP configuration');
    } catch (error) {
      console.error('❌ Failed to create application:', error);
      process.exit(1);
    }
  });

program
  .command('create <app-name>')
  .description('Create a new MCP application')
  .option('-t, --template <template>', 'Application template (blog, ecommerce, crm, todo)')
  .option('-o, --output <dir>', 'Output directory', './')
  .action(async (appName, options) => {
    let template = options.template;
    
    // If no template specified, show interactive selection
    if (!template) {
      console.log('📋 Available templates:');
      console.log('  1. blog      - Blog management system (posts, comments)');
      console.log('  2. ecommerce - E-commerce system (products, orders)');
      console.log('  3. crm       - Customer relationship management (contacts, deals, tasks)');
      console.log('  4. todo      - Simple todo management system');
      console.log('');
      console.log('Please specify a template with --template <type>');
      console.log('Example: npx mcp-starter-kit');
      process.exit(1);
    }
    
    try {
      console.log(`🚀 Creating ${appName} with ${template} template...`);
      await createApp(appName, template, options.output);
      console.log('✅ Application created successfully!');
      console.log('');
      console.log('📋 Next steps:');
      console.log(`1. cd ${appName}`);
      console.log('2. Copy .env.example to .env and configure your credentials:');
      console.log('   - Get DATABASE_URL from Neon (https://neon.tech)');
      console.log('   - Get Kinde credentials from Kinde (https://kinde.com)');
      console.log('   - Set KINDE_ISSUER_URL, KINDE_CLIENT_ID, KINDE_CLIENT_SECRET');
      console.log('3. npm run setup-db');
      console.log('4. npm run auth-server (in a separate terminal)');
      console.log('5. npm run dev');
      console.log('');
      console.log('🔐 Authentication Setup:');
      console.log('   - Visit http://localhost:3000 to login');
      console.log('   - Copy your ID token from the auth page');
      console.log('   - Use the save_token tool in Cursor to authenticate');
      console.log('');
      console.log('🔗 Configure Cursor MCP:');
      console.log('   - Add to ~/.cursor/mcp.json:');
      console.log(`   {`);
      console.log(`     "mcpServers": {`);
      console.log(`       "${appName}": {`);
      console.log(`         "command": "node",`);
      console.log(`         "args": ["dist/universal-server.js"],`);
      console.log(`         "cwd": "${process.cwd()}/${appName}",`);
      console.log(`         "env": {`);
      console.log(`           "DATABASE_URL": "your_database_url",`);
      console.log(`           "KINDE_ISSUER_URL": "your_kinde_issuer_url",`);
      console.log(`           "KINDE_CLIENT_ID": "your_kinde_client_id",`);
      console.log(`           "KINDE_CLIENT_SECRET": "your_kinde_client_secret",`);
      console.log(`           "JWT_SECRET": "your_jwt_secret"`);
      console.log(`         }`);
      console.log(`       }`);
      console.log(`     }`);
      console.log(`   }`);
      console.log('   - Restart Cursor to load MCP configuration');
    } catch (error) {
      console.error('❌ Failed to create application:', error);
      process.exit(1);
    }
  });


program
  .command('templates')
  .description('List available application templates')
  .action(() => {
    console.log('📋 Available templates:');
    console.log('  blog      - Blog management system (posts, comments)');
    console.log('  ecommerce - E-commerce system (products, orders)');
    console.log('  crm       - Customer relationship management (contacts, deals, tasks)');
    console.log('  todo      - Simple todo management system');
  });

program.parse();
